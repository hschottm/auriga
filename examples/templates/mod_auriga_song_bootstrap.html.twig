{% extends '@Contao/mod_auriga_song.html.twig' %}

{% block cover_display %}
    {% if albumcover|default is not empty %}
        {{ albumcover|raw }}
    {% elseif coverSearch|default is not empty %}
        {% set carouselId = 'auriga-covers-' ~ random() %}
        {% set activeIndex = usecover|default(0) %}
        <div id="{{ carouselId }}" class="carousel slide carousel-dark"
             data-bs-interval="false" data-bs-wrap="false"
             role="region" aria-roledescription="Karussell" aria-label="Covervorschläge">
            <div class="carousel-inner">
                {% for coverUrl in coverSearch %}
                    <div class="carousel-item{{ loop.index0 == activeIndex ? ' active' : '' }}">
                        <img src="{{ coverUrl }}" class="img-fluid albumart d-block mx-auto"
                             alt="Covervorschlag {{ loop.index }} für {{ song.album }}">
                        <div class="text-center mt-3 mb-2">
                            <p>{{ loop.index }} / {{ loop.length }}</p>
                            {% if isAdmin %}
                                <form method="post" action="{{ formaction }}">
                                    <input type="hidden" name="FORM_SUBMIT" value="image">
                                    <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                                    <input type="hidden" name="usecover" value="{{ loop.index0 }}">
                                    <button type="submit" class="btn btn-primary">Dieses Cover speichern</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% if coverSearch|length > 1 %}
                <div class="d-flex justify-content-between gap-2 mt-2">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-target="#{{ carouselId }}" data-bs-slide="prev">
                        {{ lngShowPrevCover }}
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-target="#{{ carouselId }}" data-bs-slide="next">
                        {{ lngShowNextCover }}
                    </button>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="coverplaceholder">{{ song.album }}</div>
    {% endif %}
{% endblock %}
