<?php $escape = static function ($value) { return htmlspecialchars((string) ($value ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8', false); }; ?>

<div class="<?php echo $escape($this->class); ?> ptw_broadcast"<?php echo $this->cssID; ?><?php if ($this->style): ?> style="<?php echo $escape($this->style); ?>"<?php endif; ?>>
<?php if ($this->headline): ?>

<<?php echo $this->hl; ?>><?php echo $escape($this->headline); ?></<?php echo $this->hl; ?>>
<?php endif; ?>

<form method="POST" action="<?php echo $escape($this->formaction); ?>">
<input type="hidden" name="FORM_SUBMIT" value="dpi" />
<input type="hidden" name="REQUEST_TOKEN" value="<?php echo REQUEST_TOKEN; ?>" />
<div>
<?php echo $this->lngSearch; ?> <input type="text" name="search" <?php if (strlen((string) ($this->savedSearch ?? ''))) echo 'value="' . $escape($this->savedSearch) . '" ' ?>/> <?php echo $this->lngIn; ?>
<select name="field"><?php foreach ($this->options as $option): ?><option value="<?php echo $option; ?>" <?php if (strcmp($option, $this->savedField) == 0) echo ' selected="selected"' ?>><?php echo $this->$option; ?></option><?php endforeach; ?></select>
<input type="submit" class="submit" name="submit" value="<?php echo $this->lngSearchButton; ?>" />
</div>
<div>
	<?php echo $this->resultsperpage; ?> <select name="results"><?php foreach ($this->results as $result): ?><option value="<?php echo $result; ?>" <?php if ($result == $this->savedResults) echo ' selected="selected"'; ?>><?php echo $result; ?></option><?php endforeach; ?></select>
</div>
</form>

<?php if ($this->foundResults): ?>
<div class="resultinfo"><?php echo $this->searchResult; ?> <?php echo $this->resFrom; ?> - <?php echo $this->resTo; ?> <?php echo $this->of; ?> <?php echo $this->resTotal; ?></div>
<table>
	<thead>
	<tr>
		<th><?php echo $this->adventure; ?></th>
		<th colspan="2"><?php echo $this->title; ?></th>
		<th><?php echo $this->artist; ?></th>
		<th colspan="2"><?php echo $this->album; ?></th>
		<th><?php echo $this->year; ?></th>
		<th><?php echo $this->labelcode; ?></th>
		<th><?php echo $this->genres; ?></th>
	</tr>
	</thead>
	<tbody>
<?php foreach ($this->foundsongs as $song): ?>
	<tr>
		<td><a href="<?php echo $escape($song['advurl']); ?>"><?php echo $escape($song['adventure']); ?></a></td>
		<td><?php echo $song['special']; ?></td>
		<td><a href="<?php echo $escape($song['titleurl']); ?>"><?php echo $escape($song['title']); ?></a></td>
		<td><a href="<?php echo $escape($song['artisturl']); ?>"><?php echo $escape($song['artist']); ?></a></td>
		<td class="cover"><a href="<?php echo $escape($song['idurl']); ?>"><?php echo $song['cover']; ?></a></td>
		<td><a href="<?php echo $escape($song['albumurl']); ?>"><?php echo $escape($song['album']); ?></a></td>
		<td><?php echo $escape($song['year']); ?></td>
		<td><a href="<?php echo $escape($song['labelurl']); ?>"><?php echo $escape($song['labelcode']); ?></a></td>
		<td><?php echo $escape(join('/', array_values($song['genres']))); ?></td>
	</tr>
<?php endforeach; ?>
	</tbody>
</table>
<?php echo $this->pagination; ?>
<?php endif; ?>
</div>
