<?php $escape = static function ($value) { return htmlspecialchars((string) ($value ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8', false); }; ?>
<?php if (is_array($this->broadcasts)): ?>
<div class="<?php echo $escape($this->class); ?> ptw_broadcast"<?php echo $this->cssID; ?><?php if ($this->style): ?> style="<?php echo $escape($this->style); ?>"<?php endif; ?>>
<?php if ($this->headline): ?>
<<?php echo $this->hl; ?>><?php echo $escape($this->headline); ?></<?php echo $this->hl; ?>>
<?php endif; ?>
<div class="row">
	<div class="col-12 order-1 col-md-6 order-md-0">
		<h2><a href="<?php echo $escape($this->urlUp); ?>"><?php echo $escape($this->adventure['numbering']) . '. ' . $escape($this->adventure['title']); ?></a></h2>
	</div>
	<div class="col-12 order-0 col-md-6 order-md-1">
		<div class="auriganav">
			<?php if (strlen((string) ($this->nav_first_url ?? ''))): ?><a href="<?php echo $escape($this->nav_first_url); ?>"><?php endif; ?><img src="files/auriga/images/control_start<?php echo (strlen((string) ($this->nav_first_url ?? ''))) ? '_blue' : ''; ?>.png" alt="<?php echo $escape($this->nav_first_title); ?>" title="<?php echo $escape($this->nav_first_title); ?>" /><?php if (strlen((string) ($this->nav_first_url ?? ''))): ?></a><?php endif; ?>
			<?php if (strlen((string) ($this->nav_prev_url ?? ''))): ?><a href="<?php echo $escape($this->nav_prev_url); ?>"><?php endif; ?><img src="files/auriga/images/control_rewind<?php echo (strlen((string) ($this->nav_prev_url ?? ''))) ? '_blue' : ''; ?>.png" alt="<?php echo $escape($this->nav_prev_title); ?>" title="<?php echo $escape($this->nav_prev_title); ?>" /><?php if (strlen((string) ($this->nav_prev_url ?? ''))): ?></a><?php endif; ?>
			<?php if (strlen((string) ($this->nav_next_url ?? ''))): ?><a href="<?php echo $escape($this->nav_next_url); ?>"><?php endif; ?><img src="files/auriga/images/control_fastforward<?php echo (strlen((string) ($this->nav_next_url ?? ''))) ? '_blue' : ''; ?>.png" alt="<?php echo $escape($this->nav_next_title); ?>" title="<?php echo $escape($this->nav_next_title); ?>" /><?php if (strlen((string) ($this->nav_next_url ?? ''))): ?></a><?php endif; ?>
			<?php if (strlen((string) ($this->nav_last_url ?? ''))): ?><a href="<?php echo $escape($this->nav_last_url); ?>"><?php endif; ?><img src="files/auriga/images/control_end<?php echo (strlen((string) ($this->nav_last_url ?? ''))) ? '_blue' : ''; ?>.png" alt="<?php echo $escape($this->nav_last_title); ?>" title="<?php echo $escape($this->nav_last_title); ?>"/><?php if (strlen((string) ($this->nav_last_url ?? ''))): ?></a><?php endif; ?>
		</div>
	</div>
</div>
<p class="shortstory"><?php echo $this->adventure['description']; ?></p>
<h3><?php echo $this->broadcasts[0]['chapter']; ?>. Kapitel, gesendet am <?php echo $this->broadcasts[0]['date']; ?></h3>
<?php foreach ($this->broadcasts as $broadcast): ?>
<h4><?php echo $escape($broadcast['hour']); ?>. Stunde<?php if (strlen((string) ($broadcast['title'] ?? ''))): ?>: <?php endif; ?><?php echo $escape($broadcast['title']); ?><?php if ($broadcast['isStory']) { echo " (" . $escape($this->adventure['numbering']) . ". Abenteuer, " . $escape($broadcast['chapter']) . ".Kapitel)"; } ?></h4>
<?php if (count($broadcast['songs']) > 0): ?>
<table>
	<thead>
	<tr>
		<th colspan="3"><?php echo $this->lngTitle; ?></th>
		<th><?php echo $this->lngArtist; ?></th>
		<th colspan="2"><?php echo $this->lngAlbum; ?></th>
		<th><?php echo $this->lngYear; ?></th>
		<th><?php echo $this->lngLabelcode; ?></th>
		<th><?php echo $this->lngGenres; ?></th>
	</tr>
	</thead>
	<tbody>
<?php foreach ($broadcast['songs'] as $song): ?>
	<tr>
		<td><?php echo $escape($song['sequence']); ?>.</td>
		<td><?php echo $song['special']; ?></td>
		<td><a href="<?php echo $escape($song['titleurl']); ?>"><?php echo $escape($song['title']); ?></a></td>
		<td><a href="<?php echo $escape($song['artisturl']); ?>"><?php echo $escape($song['artist']); ?></a></td>
		<td class="cover"><a href="<?php echo $escape($song['idurl']); ?>"><?php echo $song['cover']; ?></a></td>
		<td><a href="<?php echo $escape($song['albumurl']); ?>"><?php echo $escape($song['album']); ?></a></td>
		<td><?php echo $escape($song['year']); ?></td>
		<td><a href="<?php echo $escape($song['labelurl']); ?>"><?php echo $escape($song['labelcode']); ?></a></td>
		<td><?php echo $escape(join('/', array_values($song['genres']))); ?></td>
	</tr>
<?php endforeach; ?>
	</tbody>
</table>
<?php endif; ?>
<?php endforeach; ?>

<?php if (is_array($this->titlesong)): ?>
<h4><?php echo $this->lngBackgroundMusic; ?></h4>
<table>
	<thead>
	<tr>
		<th colspan="2"><?php echo $this->lngTitle; ?></th>
		<th><?php echo $this->lngArtist; ?></th>
		<th colspan="2"><?php echo $this->lngAlbum; ?></th>
		<th><?php echo $this->lngYear; ?></th>
		<th><?php echo $this->lngLabelcode; ?></th>
		<th><?php echo $this->lngGenres; ?></th>
	</tr>
	</thead>
	<tbody>
	<tr>
		<td><?php echo $this->titlesong['special']; ?></td>
		<td><?php echo $escape($this->titlesong['title']); ?></td>
		<td><?php echo $escape($this->titlesong['artist']); ?></td>
		<td class="cover"><a href="<?php echo $escape($this->titlesong['titleurl']); ?>"><?php echo $this->titlesong['cover']; ?></a></td>
		<td><?php echo $escape($this->titlesong['album']); ?></td>
		<td><?php echo $escape($this->titlesong['year']); ?></td>
		<td><?php echo $escape($this->titlesong['labelcode']); ?></td>
		<td><?php echo $escape(join('/', array_values($this->titlesong['genres']))); ?></td>
	</tr>
	</tbody>
</table>
<?php endif; ?>

</div>
<?php endif; ?>
