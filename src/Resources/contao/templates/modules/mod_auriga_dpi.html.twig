{% block content %}
<div{{ attrs(cssID|default).addClass([class|default, 'ptw_broadcast']).addStyle(style|default) }}>
{% block headline %}
{% if headline %}<{{ hl }}>{{ headline }}</{{ hl }}>{% endif %}
{% endblock %}

{% block search_form %}
<form method="POST" action="{{ formaction }}"{% block form_attributes %}{% endblock %}>
{% block hidden_fields %}
<input type="hidden" name="FORM_SUBMIT" value="dpi" />
<input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}" />
{% endblock %}
{% block search_fields %}
<div>
{% block search_input %}<label>{{ lngSearch }} <input type="text" name="search" value="{{ savedSearch|default }}"{% block search_attributes %}{% endblock %}/></label>{% endblock %}
{% block field_select %}<label>{{ lngIn }} <select name="field"{% block field_attributes %}{% endblock %}>{% for option in options %}<option value="{{ option }}" {% if option == savedField %} selected{% endif %}>{{ attribute(_context, option) }}</option>{% endfor %}</select></label>{% endblock %}
{% block submit_button %}<input type="submit" class="{% block submit_class %}submit{% endblock %}" name="submit" value="{{ lngSearchButton }}" />{% endblock %}
</div>
{% endblock %}
{% block results_select %}
<div>
<label>{{ resultsperpage }} <select name="results"{% block results_attributes %}{% endblock %}>{% for result in results %}<option value="{{ result }}" {% if result == savedResults %} selected{% endif %}>{{ result }}</option>{% endfor %}</select></label>
</div>
{% endblock %}
</form>
{% endblock %}

{% if foundResults %}
{% block result_info %}<div class="{% block result_info_class %}resultinfo{% endblock %}">{{ searchResult }} {{ resFrom }} - {{ resTo }} {{ of }} {{ resTotal }}</div>{% endblock %}
{% block table_wrapper %}
<table{% block table_attributes %}{% endblock %}>
{% block table_head %}
	<thead>
	<tr>
		<th>{{ adventure }}</th>
		<th colspan="2">{{ title }}</th>
		<th>{{ artist }}</th>
		<th colspan="2">{{ album }}</th>
		<th>{{ year }}</th>
		<th>{{ labelcode }}</th>
		<th>{{ genres }}</th>
	</tr>
	</thead>
{% endblock %}
{% block table_body %}
	<tbody>
{% for song in foundsongs %}
{% block table_row %}
	<tr>
		<td><a href="{{ song.advurl }}">{{ song.adventure }}</a></td>
		<td>{{ song.special|raw }}</td>
		<td><a href="{{ song.titleurl }}">{{ song.title }}</a></td>
		<td><a href="{{ song.artisturl }}">{{ song.artist }}</a></td>
		<td class="cover"><a href="{{ song.idurl }}">{{ song.cover|raw }}</a></td>
		<td><a href="{{ song.albumurl }}">{{ song.album }}</a></td>
		<td>{{ song.year }}</td>
		<td><a href="{{ song.labelurl }}">{{ song.labelcode }}</a></td>
		<td>{{ song.genres|join('/') }}</td>
	</tr>
{% endblock %}
{% endfor %}
	</tbody>
{% endblock %}
</table>
{% endblock %}
{% block pagination %}{{ pagination|raw }}{% endblock %}
{% endif %}
</div>
{% endblock %}
