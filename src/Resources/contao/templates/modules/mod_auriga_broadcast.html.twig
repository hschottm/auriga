{% block content %}
{% if broadcasts|default is iterable %}
<div{{ attrs(cssID|default).addClass([class|default, 'ptw_broadcast']).addStyle(style|default) }}>
{% if headline %}
<{{ hl }}>{{ headline }}</{{ hl }}>
{% endif %}
<div class="row">
	<div class="col-12 order-1 col-md-6 order-md-0">
		<h2><a href="{{ urlUp }}">{{ adventure.numbering }}. {{ adventure.title }}</a></h2>
	</div>
	<div{% block navigation_column_attributes %} class="col-12 order-0 col-md-6 order-md-1"{% endblock %}>
		{% block navigation_wrapper %}
		<div class="auriganav">
            {% block navigation_controls %}
            <span class="auriga-chapter-controls">
            {% for key in ['first', 'prev', 'next', 'last'] %}
                {% set target = attribute(_context, 'nav_' ~ key ~ '_url')|default('') %}
                {% set label = attribute(_context, 'nav_' ~ key ~ '_title')|default('') %}
                {% if target %}
                    <a class="auriga-chapter-control" href="{{ target }}" title="{{ label }}" aria-label="{{ label }}">
                {% else %}
                    <span class="auriga-chapter-control is-disabled" role="link" aria-disabled="true" title="{{ label }}" aria-label="{{ label }}">
                {% endif %}
                {% if key == 'first' %}
<svg aria-hidden="true" focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m11 17-5-5 5-5" />
  <path d="m18 17-5-5 5-5" />
</svg>

                {% elseif key == 'prev' %}
<svg aria-hidden="true" focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m15 18-6-6 6-6" />
</svg>

                {% elseif key == 'next' %}
<svg aria-hidden="true" focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m9 18 6-6-6-6" />
</svg>

                {% elseif key == 'last' %}
<svg aria-hidden="true" focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m6 17 5-5-5-5" />
  <path d="m13 17 5-5-5-5" />
</svg>

                {% endif %}
                {% if target %}</a>{% else %}</span>{% endif %}
            {% endfor %}
            </span>
            {% endblock %}
		</div>
        {% endblock %}
	</div>
</div>
<p class="shortstory">{{ adventure.description|raw }}</p>
<h3>{{ broadcasts[0].chapter }}. Kapitel, gesendet am {{ broadcasts[0].date }}</h3>
{% for broadcast in broadcasts %}
<h4>{{ broadcast.hour }}. Stunde{% if broadcast.title|default is not empty %}: {% endif %}{{ broadcast.title }}{% if broadcast.isStory %} ({{ adventure.numbering }}. Abenteuer, {{ broadcast.chapter }}.Kapitel){% endif %}</h4>
{% if broadcast.songs|length > 0 %}
{% block table_wrapper %}
<table{% block table_attributes %}{% endblock %}>
	<thead{% block table_head_attributes %}{% endblock %}>
	<tr>
		<th colspan="3">{{ lngTitle }}</th>
		<th>{{ lngArtist }}</th>
		<th colspan="2">{{ lngAlbum }}</th>
		<th>{{ lngYear }}</th>
		<th>{{ lngLabelcode }}</th>
		<th>{{ lngGenres }}</th>
	</tr>
	</thead>
	<tbody>
{% for song in broadcast.songs %}
	<tr>
		<td>{{ song.sequence }}.</td>
		<td>{{ song.special|raw }}</td>
		<td><a href="{{ song.titleurl }}">{{ song.title }}</a></td>
		<td><a href="{{ song.artisturl }}">{{ song.artist }}</a></td>
		<td class="cover"><a href="{{ song.idurl }}">{{ song.cover|raw }}</a></td>
		<td><a href="{{ song.albumurl }}">{{ song.album }}</a></td>
		<td>{{ song.year }}</td>
		<td><a href="{{ song.labelurl }}">{{ song.labelcode }}</a></td>
		<td>{{ song.genres|join('/') }}</td>
	</tr>
{% endfor %}
	</tbody>
</table>
{% endblock %}
{% endif %}
{% endfor %}

{% if titlesong|default is iterable %}
<h4>{{ lngBackgroundMusic }}</h4>
{% block titlesong_table_wrapper %}
<table{{ block('table_attributes') }}>
	<thead{{ block('table_head_attributes') }}>
	<tr>
		<th colspan="2">{{ lngTitle }}</th>
		<th>{{ lngArtist }}</th>
		<th colspan="2">{{ lngAlbum }}</th>
		<th>{{ lngYear }}</th>
		<th>{{ lngLabelcode }}</th>
		<th>{{ lngGenres }}</th>
	</tr>
	</thead>
	<tbody>
	<tr>
		<td>{{ titlesong.special|raw }}</td>
		<td>{{ titlesong.title }}</td>
		<td>{{ titlesong.artist }}</td>
		<td class="cover"><a href="{{ titlesong.titleurl }}">{{ titlesong.cover|raw }}</a></td>
		<td>{{ titlesong.album }}</td>
		<td>{{ titlesong.year }}</td>
		<td>{{ titlesong.labelcode }}</td>
		<td>{{ titlesong.genres|join('/') }}</td>
	</tr>
	</tbody>
</table>
{% endblock %}
{% endif %}

{% block story_section %}
{% set storyBroadcasts = broadcasts|filter(broadcast => broadcast.storycontent|default('')|trim is not empty) %}
{% if storyBroadcasts|length %}
<section class="auriga-adventure-story">
    {% block story_heading %}<h4>{{ lngAdventureStory }}</h4>{% endblock %}
    {% block story_content %}
    {% for broadcast in storyBroadcasts %}
        <div class="auriga-story-text">{{ broadcast.storyhtml|raw }}</div>
    {% endfor %}
    {% endblock %}
</section>
{% endif %}
{% endblock %}

</div>
{% endif %}
{% endblock %}
