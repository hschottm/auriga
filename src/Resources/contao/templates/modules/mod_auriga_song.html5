<?php $escape = static function ($value) { return htmlspecialchars((string) ($value ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8', false); }; ?>
<?php if (is_array($this->song)): ?>
<div class="<?php echo $escape($this->class); ?> ptw_song"<?php echo $this->cssID; ?><?php if ($this->style): ?> style="<?php echo $escape($this->style); ?>"<?php endif; ?>>
<?php if ($this->headline): ?>

<<?php echo $this->hl; ?>><?php echo $escape($this->headline); ?></<?php echo $this->hl; ?>>
<?php endif; ?>
<div class="ptwpath">
<?php for ($i = 0; $i < count($this->currentpath); $i++): ?>
	<a href="<?php echo $escape($this->currentpath[$i]['url']); ?>"><?php echo $escape($this->currentpath[$i]['title']); ?></a> <?php if ($i < count($this->currentpath)-1): ?><?php echo "&gt;"; ?><?php endif; ?>
<?php endfor; ?>
</div>
<?php foreach (($this->coverErrors ?? array()) as $error): ?>
<p class="error"><?php echo htmlspecialchars($error, ENT_QUOTES); ?></p>
<?php endforeach; ?>
<table>
	<tbody>
	<tr>
		<td class="key"><?php echo $this->lngCover; ?></td>
		<td class="value">
<?php if (!strlen((string) ($this->albumcover ?? '')) && !strlen((string) ($this->possibleImage ?? ''))): ?>
	<div class="coverplaceholder"><?php echo $escape($this->song['album']); ?></div>
<?php endif; ?>
<?php if (strlen((string) ($this->albumcover ?? ''))): ?>
			<?php echo $this->albumcover; ?>
<?php endif; ?>
<?php if (strlen((string) ($this->possibleImage ?? ''))): ?>
			<div class="coverquestion"><form method="POST" action="<?php echo $escape($this->formaction); ?>">
<input type="hidden" name="FORM_SUBMIT" value="image" />
<input type="hidden" name="REQUEST_TOKEN" value="<?php echo $this->requestToken; ?>" />
<?php if (strlen((string) ($this->urlShowPrev ?? ''))): ?><a href="<?php echo $escape($this->urlShowPrev); ?>"><?php endif; ?><img src="files/auriga/images/control_rewind<?php echo (strlen((string) ($this->urlShowPrev ?? ''))) ? '_blue' : ''; ?>.png" alt="<?php echo $this->lngShowPrevCover; ?>" title="<?php echo $this->lngShowPrevCover; ?>" /><?php if (strlen((string) ($this->urlShowPrev ?? ''))): ?></a><?php endif; ?>
<?php if (strlen((string) ($this->imagePosition ?? ''))): ?> (<?php echo $this->imagePosition; ?>) <?php endif; ?>
<?php if (strlen((string) ($this->urlShowNext ?? ''))): ?><a href="<?php echo $escape($this->urlShowNext); ?>"><?php endif; ?><img src="files/auriga/images/control_fastforward<?php echo (strlen((string) ($this->urlShowNext ?? ''))) ? '_blue' : ''; ?>.png" alt="<?php echo $this->lngShowNextCover; ?>" title="<?php echo $this->lngShowNextCover; ?>" /><?php if (strlen((string) ($this->urlShowNext ?? ''))): ?></a><?php endif; ?>
<?php echo $this->lngCorrectCover; ?> <input type="hidden" name="usecover" value="<?php echo $this->usecover; ?>" /><input type="submit" name="submit" value="<?php echo $this->lngYes; ?>" /></form></div>
<?php echo $this->possibleImage; ?>
<?php endif; ?>
<?php if ($this->isAdmin): ?>
<?php if (!$this->albumcover && !$this->possibleImage): ?>
<p>Keine Covervorschläge verfügbar. Du kannst einen anderen Albumtitel suchen oder ein Bild hochladen.</p>
<?php endif; ?>
<?php if (!strlen((string) ($this->albumcover ?? ''))): ?>
<div>
		<form method="POST" action="<?php echo $escape($this->formaction); ?>">
			<input type="hidden" name="FORM_SUBMIT" value="searchform" />
			<input type="hidden" name="REQUEST_TOKEN" value="<?php echo $this->requestToken; ?>" />
			<label for="search_own"><?php echo $this->lngSearchOwn; ?></label>
			<input type="text" id="search_own" name="searchtext" <?php if (strlen((string) ($this->searchValue ?? ''))): ?>value="<?php echo $escape($this->searchValue); ?>" <?php endif; ?>/>
			<input type="submit" name="search" value="<?php echo $this->lngSearch; ?>" />
		</form>
</div>
<div>
		<form method="POST" action="<?php echo $escape($this->formaction); ?>" enctype="multipart/form-data">
			<input type="hidden" name="FORM_SUBMIT" value="uploadform" />
			<input type="hidden" name="REQUEST_TOKEN" value="<?php echo $this->requestToken; ?>" />
			<label for="upload"><?php echo $this->lngUploadCover; ?></label>
			<input type="file" id="upload" name="uploadcover" />
			<input type="submit" name="upload" value="<?php echo $this->lngUpload; ?>" />
		</form>
</div>
<?php endif; ?>
<?php endif; ?>
		</td>
	</tr>
	<tr>
		<td class="key"><?php echo $this->lngTitle; ?></td>
		<td class="value"><?php echo $escape($this->song['title']); ?></td>
	</tr>
	<tr>
		<td class="key"><?php echo $this->lngArtist; ?></td>
		<td class="value"><?php echo $escape($this->song['artist']); ?></td>
	</tr>
	<tr>
		<td class="key"><?php echo $this->lngAlbum; ?></td>
		<td class="value"><?php echo $escape($this->song['album']); ?></td>
	</tr>
	<tr>
		<td class="key"><?php echo $this->lngYear; ?></td>
		<td class="value"><?php echo $escape($this->song['year']); ?></td>
	</tr>
	<tr>
		<td class="key"><?php echo $this->lngLabelcode; ?></td>
		<td class="value"><?php echo $escape($this->song['labelcode']); ?></td>
	</tr>
<?php if (strlen((string) ($this->song['special'] ?? ''))): ?>
	<tr>
		<td class="key"><?php echo $this->lngSongtype; ?></td>
		<td class="value"><?php echo $this->song['special']; ?></td>
	</tr>
<?php endif; ?>
<?php if (strlen((string) ($this->song['length'] ?? ''))): ?>
	<tr>
		<td class="key"><?php echo $this->lngLength; ?></td>
		<td class="value"><?php echo $escape($this->song['length']); ?></td>
	</tr>
<?php endif; ?>
<?php if (strlen((string) ($this->song['composer'] ?? ''))): ?>
	<tr>
		<td class="key"><?php echo $this->lngComposer; ?></td>
		<td class="value"><?php echo $escape($this->song['composer']); ?></td>
	</tr>
<?php endif; ?>
<?php if (count($this->song['genres'])): ?>
	<tr>
		<td class="key"><?php echo $this->lngGenres; ?></td>
		<td class="value"><?php echo $escape(join(", ", $this->song['genres'])); ?></td>
	</tr>
<?php endif; ?>
	</tbody>
</table>
</div>
<?php endif; ?>
