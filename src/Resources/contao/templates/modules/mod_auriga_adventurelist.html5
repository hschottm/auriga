<?php $escape = static function ($value) { return htmlspecialchars((string) ($value ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8', false); }; ?>

<div class="<?php echo $escape($this->class); ?> ptw_adventurelist"<?php echo $this->cssID; ?><?php if ($this->style): ?> style="<?php echo $escape($this->style); ?>"<?php endif; ?>>
<?php if ($this->headline): ?>

<<?php echo $this->hl; ?>><?php echo $escape($this->headline); ?></<?php echo $this->hl; ?>>
<?php endif; ?>

<table>
<?php foreach ($this->adventures as $adventure): ?>
  <tr>
		<td><?php echo $escape($adventure['numbering']); ?>.</td>
		<td><a href="<?php echo $escape($adventure['url']); ?>" title="<?php echo $escape($adventure['title']); ?>"><?php echo $escape($adventure['title']); ?></a></td>
	</tr>
<?php endforeach; ?>
</table>

</div>
