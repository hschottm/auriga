{% if chapters|default([]) %}<div class="auriga-audio-player" data-auriga-audio-player>{% endif %}
<audio controls preload="none" aria-label="{{ title }}"><source src="{{ url }}" type="{{ type }}"></audio>
{% if chapters|default([]) %}
    <div class="auriga-audio-chapters" hidden>
        <button class="auriga-audio-skip" type="button" data-chapter-previous aria-label="{{ chapterLabels.previous }}" title="{{ chapterLabels.previous }}">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M6 5v14M18 5l-9 7 9 7Z"/></svg>
        </button>
        <details>
            <summary aria-label="{{ chapterLabels.list }}">
                <span class="auriga-audio-current" data-chapter-current>{{ chapterLabels.list }}</span>
                <svg class="auriga-audio-chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <ol>{% for chapter in chapters %}
                <li><button type="button" data-chapter-start="{{ chapter.start }}"><span class="auriga-audio-time">{{ chapter.time }}</span> <span data-chapter-title>{{ chapter.title }}</span></button></li>
            {% endfor %}</ol>
        </details>
        <button class="auriga-audio-skip" type="button" data-chapter-next aria-label="{{ chapterLabels.next }}" title="{{ chapterLabels.next }}">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M18 5v14M6 5l9 7-9 7Z"/></svg>
        </button>
    </div>
</div>
{% endif %}
