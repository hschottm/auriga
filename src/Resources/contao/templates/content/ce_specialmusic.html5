<?php $escape = static function ($value) { return htmlspecialchars((string) ($value ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8', false); }; ?>

<div class="<?php echo $escape($this->class); ?> block ptw_broadcast"<?php echo $this->cssID; ?><?php if ($this->style): ?> style="<?php echo $escape($this->style); ?>"<?php endif; ?>>
<?php if ($this->headline): ?>

<<?php echo $this->hl; ?>><?php echo $escape($this->headline); ?></<?php echo $this->hl; ?>>
<?php endif; ?>

<table>
	<thead>
	<tr>
		<th><?php echo $this->lngAdventure; ?></th>
		<th colspan="2"><?php echo $this->lngTitle; ?></th>
		<th><?php echo $this->lngArtist; ?></th>
		<th colspan="2"><?php echo $this->lngAlbum; ?></th>
		<th><?php echo $this->lngYear; ?></th>
		<th><?php echo $this->lngLabelcode; ?></th>
		<th><?php echo $this->lngGenres; ?></th>
	</tr>
	</thead>
	<tbody>
<?php foreach ($this->songs as $song): ?>
	<tr>
		<td><?php echo $escape($song['adventure']); ?></td>
		<td><?php echo $song['special']; ?></td>
		<td><?php echo $escape($song['title']); ?></td>
		<td><?php echo $escape($song['artist']); ?></td>
		<td class="cover"><a href="<?php echo $escape($song['titleurl']); ?>"><?php echo $song['cover']; ?></a></td>
		<td><?php echo $escape($song['album']); ?></td>
		<td><?php echo $escape($song['year']); ?></td>
		<td><?php echo $escape($song['labelcode']); ?></td>
		<td><?php echo $escape(join('/', array_values($song['genres']))); ?></td>
	</tr>
<?php endforeach; ?>
	</tbody>
</table>

</div>
